# Auto detect text files and perform LF normalization
# Normalize repository text files to LF
* text=auto eol=lf

*.yml text eol=lf
*.yaml text eol=lf
*.j2 text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.md text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
*.txt text eol=lf

# Treat common generated or binary artifacts as binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.docx binary
*.zip binary

# Improve GitHub language detection
*.yml linguist-detectable=true
*.yaml linguist-detectable=true
*.j2 linguist-detectable=true
*.sh linguist-detectable=true
